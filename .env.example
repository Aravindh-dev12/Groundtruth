# --- Cloudinary ---
# From your Cloudinary console (Dashboard > API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Which Cloudinary add-ons you have enabled determine these.
# Check Console > Add-ons before relying on the values below.
# "coco_v2" is the AI Content Analysis object-detection model name
# at the time this was written; Cloudinary has changed detection/
# categorization param names before, so confirm in your account's
# Add-ons page and in the Upload API reference if analysis calls
# come back empty.
CLOUDINARY_DETECTION_MODEL=coco_v2
CLOUDINARY_CATEGORIZATION_ADDON=google_tagging
CLOUDINARY_AUTO_TAGGING_THRESHOLD=0.6

# --- Claude (Anthropic API) ---
# Used for: parsing free-text claims into structured quantities,
# and drafting the narrative impact report from verified data.
ANTHROPIC_API_KEY=
# Any current Claude model string works; Sonnet is a good default
# for this workload (structured extraction + report drafting).
ANTHROPIC_MODEL=claude-sonnet-5

# --- Auth ---
# Long random string used to sign session cookies (separate from the
# receipt-signing secret below -- rotating one shouldn't invalidate the
# other). Generate the same way:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Provenance ledger ---
# Long random string used to HMAC-sign every receipt in the chain.
# Rotate only if you also accept that old receipts can no longer
# be re-verified against a new secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RECEIPT_SIGNING_SECRET=

# --- Storage ---
# SQLite file path. Fine for local/dev and small deployments with a
# persistent disk. On stateless serverless hosts (e.g. Vercel) this
# file will NOT persist between deploys/instances -- swap lib/db.js
# for a hosted Postgres (Neon, Supabase, RDS) before going to
# production on serverless infrastructure. See README "Going to
# production" section.
DATABASE_PATH=./data/groundtruth.db
